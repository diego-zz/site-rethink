{
  "name": "rethink-ad-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Site institucional da Rethink Consultoria (www.rethink.ad) — Astro + EmDash na Cloudflare",
  "emdash": {
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "seed:build": "python3 scripts/seed/build-seed.py",
    "seed:validate": "emdash seed seed/seed.json --validate",
    "seed:assets": "node scripts/upload-seed-assets.mjs",
    "deploy:preview": "CLOUDFLARE_ENV=preview astro build && wrangler deploy",
    "deploy:production": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/react": "^7.0.0",
    "@emdash-cms/cloudflare": "1.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/league-spartan": "^5.3.0",
    "astro": "^7.3.2",
    "emdash": "1.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260820.1",
    "wrangler": "^4.125.0"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
