---
/** Card de case. "escuro": usado sobre fundo preto (Home, Solução). */
import { Image } from "emdash/ui";
import { metricaPrincipal, type Entrada } from "../lib/site";

interface Props {
	caso: Entrada;
	cliente: string;
	solucao?: string;
	variante?: "grade" | "escuro";
	nivel?: "h2" | "h3";
}
const { caso, cliente, solucao, variante = "grade", nivel = "h3" } = Astro.props;
const m = metricaPrincipal(caso);
const Tag = nivel;
---

<article class:list={["card-case", `card-case--${variante}`]}>
	<a href={`/cases/${caso.id}`} class="card-case__link">
		<span class="zoom card-case__img">
			{caso.data.imagem && <Image image={caso.data.imagem} alt="" sizes="(max-width: 720px) 100vw, 400px" />}
		</span>
		<span class="card-case__meta">
			<span>{caso.data.setor}</span>
			{solucao && <span>{solucao}</span>}
		</span>
		<Tag class="display card-case__nome">{cliente}</Tag>
		{variante === "grade" && caso.data.excerpt && <span class="card-case__resumo">{caso.data.excerpt}</span>}
		{
			m && (
				<span class="card-case__metrica">
					<span class="card-case__valor">{m.valor}</span>
					{variante === "grade" && <span class="card-case__indicador">{m.indicador}</span>}
				</span>
			)
		}
	</a>
</article>

<style>
	.card-case__link {
		display: flex;
		flex-direction: column;
		gap: 12px;
		height: 100%;
		color: var(--texto);
		text-decoration: none;
	}
	.card-case--escuro .card-case__link {
		gap: 10px;
		padding-top: 20px;
		border-top: 1px solid var(--branco);
		color: var(--branco);
	}
	.card-case__img {
		height: 280px;
	}
	.card-case--escuro .card-case__img {
		height: 240px;
	}
	.card-case__img :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.card-case__meta {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		font-family: var(--f-mono);
		font-size: 12px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--cinza);
	}
	.card-case--escuro .card-case__meta {
		justify-content: flex-start;
		color: var(--muted-escuro);
	}
	.card-case--escuro .card-case__meta span + span::before {
		content: "· ";
	}
	.card-case__nome {
		font-size: 30px;
		line-height: 1;
	}
	.card-case--escuro .card-case__nome {
		font-size: 26px;
	}
	.card-case__resumo {
		font-size: 16px;
	}
	.card-case__metrica {
		display: flex;
		align-items: baseline;
		gap: 12px;
		margin-top: auto;
		padding-top: 12px;
		border-top: 1px solid var(--linha);
	}
	.card-case--escuro .card-case__metrica {
		padding-top: 0;
		border-top: 0;
	}
	.card-case__valor {
		font-family: var(--f-mono);
		font-size: 26px;
		color: var(--azul);
	}
	.card-case--escuro .card-case__valor {
		font-size: 22px;
		color: var(--azul-escuro);
	}
	.card-case__indicador {
		font-size: 13px;
		color: var(--cinza);
	}
	@media (max-width: 720px) {
		.card-case__img,
		.card-case--escuro .card-case__img {
			height: 220px;
		}
		.card-case__nome {
			font-size: 26px;
		}
	}
</style>
