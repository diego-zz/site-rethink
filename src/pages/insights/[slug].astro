---
/** Página de um artigo (insight). */
import { decodeSlug, getEmDashEntry, getEntryTerms, getSeoMeta } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import CardInsight from "../../components/CardInsight.astro";
import CtaFaixa from "../../components/blocos/CtaFaixa.astro";
import Trilha from "../../components/Trilha.astro";
import { cachear, dataBR, dataISO, getEmpresa, getInsights, link, metaInsight, textoPT, urlImagem, type Entrada } from "../../lib/site";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");
const { entry, cacheHint } = await getEmDashEntry("insights", slug);
if (!entry) return Astro.rewrite("/404");
const a = entry as unknown as Entrada;
const d = a.data;
const [cats, tags, todos, em] = await Promise.all([
	getEntryTerms("insights", String(d.id), "categoria"),
	getEntryTerms("insights", String(d.id), "tag"),
	getInsights({ limite: 40 }),
	getEmpresa(),
]);
cachear(Astro, cacheHint, todos.cacheHint, todos.cacheHintTermos, em.cacheHint);

const origin = Astro.site?.origin ?? Astro.url.origin;
const url = `${origin}/insights/${a.id}`;
const categoria = cats[0];
const seo = getSeoMeta(entry, {
	siteUrl: origin,
	path: `/insights/${a.id}`,
	defaultDescription: d.excerpt,
	defaultOgImage: urlImagem(d.capa, origin),
});
const autor = d.byline as { displayName?: string; bio?: string; avatar?: unknown; websiteUrl?: string; slug?: string } | null;
const nomeAutor = autor?.displayName || em.empresa.title || "Rethink Consultoria";
const publicado = d.publishedAt ?? d.createdAt;
const texto = textoPT(d.content);
const minutos = d.tempo_leitura || Math.max(1, Math.round(texto.split(/\s+/).length / 200));
const relacionados = todos.insights
	.filter((x) => x.id !== a.id)
	.sort((x, y) => Number(todos.categoriaDe(y)?.slug === categoria?.slug) - Number(todos.categoriaDe(x)?.slug === categoria?.slug))
	.slice(0, 3);
const linkedin = link(d.link_linkedin);
const compartilhar = {
	linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`,
	whatsapp: `https://wa.me/?text=${encodeURIComponent(`${d.title} ${url}`)}`,
};
const empresa = em.empresa;
const artigo = {
	"@context": "https://schema.org",
	"@type": "Article",
	"@id": `${url}#artigo`,
	headline: d.title,
	alternativeHeadline: d.linha_fina || undefined,
	description: d.excerpt,
	image: urlImagem(d.capa, origin),
	datePublished: dataISO(publicado),
	dateModified: dataISO(d.updatedAt),
	inLanguage: "pt-BR",
	author: autor?.displayName ? { "@type": "Person", name: autor.displayName, description: autor.bio || undefined } : { "@id": `${origin}/#organizacao` },
	publisher: { "@id": `${origin}/#organizacao` },
	articleSection: categoria?.label,
	keywords: tags.map((t) => t.label).join(", ") || undefined,
	wordCount: texto.split(/\s+/).filter(Boolean).length || undefined,
	timeRequired: `PT${minutos}M`,
	mainEntityOfPage: url,
	sameAs: linkedin && /linkedin\.com\/(posts|pulse|feed)/.test(linkedin) ? [linkedin] : undefined,
};
---

<Base
	title={seo.title}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	content={{ collection: "insights", id: d.id, slug: a.id }}
	tipo="article"
	artigo={{ publicado: dataISO(publicado), modificado: dataISO(d.updatedAt), autor: nomeAutor }}
	jsonld={[artigo]}
>
	<article>
		<header class="art-cab">
			<Trilha itens={[{ nome: "Insights", url: "/insights" }, { nome: d.title.length > 48 ? `${d.title.slice(0, 46)}…` : d.title }]} />
			{categoria && <a href={`/insights?categoria=${categoria.slug}`} class="art-cat">{categoria.label}</a>}
			<h1 class="art-titulo" {...a.edit?.title}>{d.title}</h1>
			{d.linha_fina && <p class="art-fina">{d.linha_fina}</p>}
			<div class="art-meta">
				<div class="art-autor">
					<span class="art-autor__nome">{nomeAutor}</span>
					<span class="art-autor__data">
						<time datetime={dataISO(publicado)}>{dataBR(publicado)}</time> · {minutos} min de leitura
					</span>
				</div>
				<div class="art-share">
					<span class="mono-caps">Compartilhar</span>
					<a href={compartilhar.linkedin} target="_blank" rel="noopener noreferrer" aria-label="Compartilhar no LinkedIn">in</a>
					<a href={compartilhar.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="Compartilhar no WhatsApp">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12a9 9 0 0 1-13.5 7.8L3 21l1.3-4.4A9 9 0 1 1 21 12z"></path></svg>
					</a>
					<button type="button" aria-label="Copiar link" data-copiar={url}>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"></path><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"></path></svg>
					</button>
					<span class="sr-only" role="status" data-copiado></span>
				</div>
			</div>
		</header>

		{
			d.capa && (
				<figure class="container art-capa">
					<Image image={d.capa} priority sizes="(max-width: 1280px) 100vw, 1232px" />
					{d.legenda_capa && <figcaption>{d.legenda_capa}</figcaption>}
				</figure>
			)
		}

		<div class="art-corpo" {...a.edit?.content}>
			<PortableText value={d.content} />
			{
				tags.length > 0 && (
					<ul class="art-tags" aria-label="Tags">
						{tags.map((t) => (
							<li>#{t.label}</li>
						))}
					</ul>
				)
			}
			{
				linkedin && (
					<p class="art-linkedin">
						<a href={linkedin} target="_blank" rel="noopener noreferrer">Comente este artigo no LinkedIn →</a>
					</p>
				)
			}
		</div>

		<aside class="art-bio" aria-label="Sobre o autor">
			<div>
				<strong>{nomeAutor}</strong>
				{autor?.bio && <span>{autor.bio}</span>}
				{empresa.linkedin_url && <a href={empresa.linkedin_url} target="_blank" rel="noopener noreferrer">Seguir a Rethink no LinkedIn →</a>}
			</div>
		</aside>
	</article>

	{
		relacionados.length > 0 && (
			<section aria-labelledby="h-rel" class="fundo-branco art-rel">
				<div class="container art-rel__corpo">
					<div class="cab-secao">
						<h2 id="h-rel" class="display art-rel__titulo">Leia também.</h2>
						<a href="/insights" class="link-mono">
							Todos os insights <span aria-hidden="true">→</span>
						</a>
					</div>
					<div class="art-rel__grade">
						{relacionados.map((r) => (
							<CardInsight artigo={r} meta={metaInsight(r, todos.categoriaDe(r))} variante="texto" />
						))}
					</div>
				</div>
			</section>
		)
	}

	<CtaFaixa
		value={{
			_key: "art-cta",
			titulo: empresa.cta_titulo || "Vamos repensar\njuntos?",
			botao_texto: empresa.cta_botao || "Fale com a gente",
			botao_link: "/contato",
		}}
	/>
</Base>

<script>
	document.querySelectorAll<HTMLButtonElement>("[data-copiar]").forEach((b) =>
		b.addEventListener("click", async () => {
			const aviso = document.querySelector("[data-copiado]");
			try {
				await navigator.clipboard.writeText(b.dataset.copiar ?? location.href);
				if (aviso) aviso.textContent = "Link copiado.";
				b.classList.add("copiado");
				setTimeout(() => b.classList.remove("copiado"), 1600);
			} catch {
				if (aviso) aviso.textContent = "Não foi possível copiar o link.";
			}
		}),
	);
</script>

<style>
	.art-cab {
		max-width: 880px;
		margin-inline: auto;
		display: flex;
		flex-direction: column;
		gap: 24px;
		padding: 24px var(--gutter) 48px;
	}
	.art-cat {
		padding-top: 40px;
		font-family: var(--f-mono);
		font-size: 12px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--azul);
		text-decoration: none;
	}
	.art-titulo {
		font-size: clamp(36px, 5vw, 56px);
		line-height: 1.1;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--preto);
		text-wrap: balance;
	}
	.art-fina {
		font-size: 21px;
		line-height: 1.5;
		color: var(--cinza);
	}
	.art-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 16px 32px;
		align-items: center;
		justify-content: space-between;
		padding: 16px 0;
		border-top: 1px solid var(--preto);
		border-bottom: 1px solid var(--linha);
	}
	.art-autor {
		display: flex;
		flex-direction: column;
		line-height: 1.3;
	}
	.art-autor__nome {
		font-weight: 600;
		font-size: 15px;
		color: var(--preto);
	}
	.art-autor__data {
		font-family: var(--f-mono);
		font-size: 12px;
		color: var(--cinza);
	}
	.art-share {
		display: flex;
		gap: 8px;
		align-items: center;
	}
	.art-share .mono-caps {
		margin-right: 4px;
	}
	.art-share a,
	.art-share button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border: 1px solid var(--preto);
		background: transparent;
		color: var(--preto);
		text-decoration: none;
		font-family: var(--f-mono);
		font-size: 13px;
		font-weight: 500;
		cursor: pointer;
	}
	.art-share a:hover,
	.art-share button:hover,
	.art-share button:global(.copiado) {
		background: var(--preto);
		color: var(--branco);
	}
	.art-capa {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.art-capa :global(img) {
		width: 100%;
		height: 600px;
		object-fit: cover;
	}
	.art-capa figcaption {
		font-size: 13px;
		color: var(--cinza);
	}
	.art-corpo {
		max-width: 720px;
		margin-inline: auto;
		display: flex;
		flex-direction: column;
		gap: 24px;
		padding: 72px var(--gutter) 48px;
		font-size: 19px;
		line-height: 1.7;
	}
	.art-corpo :global(> *) {
		margin: 0;
	}
	.art-corpo :global(h2) {
		margin-top: 24px;
		font-size: 30px;
		line-height: 1.2;
		font-weight: 600;
		color: var(--preto);
	}
	.art-corpo :global(h3) {
		margin-top: 16px;
		font-size: 23px;
		line-height: 1.3;
		font-weight: 600;
		color: var(--preto);
	}
	.art-corpo :global(ul),
	.art-corpo :global(ol) {
		padding-left: 22px;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.art-corpo :global(blockquote) {
		margin: 16px 0;
		padding: 0;
		font-size: 28px;
		line-height: 1.35;
		font-weight: 500;
		color: var(--preto);
	}
	.art-corpo :global(img) {
		width: 100%;
		height: auto;
	}
	.art-corpo :global(figcaption) {
		margin-top: 8px;
		font-size: 13px;
		color: var(--cinza);
	}
	.art-corpo :global(a) {
		text-underline-offset: 3px;
	}
	.art-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		padding: 16px 0 0;
		list-style: none;
	}
	.art-tags li {
		display: inline-flex;
		align-items: center;
		min-height: 36px;
		padding: 0 14px;
		border: 1px solid var(--linha);
		background: var(--branco);
		font-family: var(--f-mono);
		font-size: 12px;
	}
	.art-linkedin {
		font-size: 16px;
	}
	.art-bio {
		max-width: 720px;
		margin-inline: auto;
		padding: 0 var(--gutter) 96px;
	}
	.art-bio div {
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 28px;
		background: var(--branco);
		border: 1px solid var(--linha);
	}
	.art-bio strong {
		color: var(--preto);
	}
	.art-bio span {
		font-size: 15px;
	}
	.art-bio a {
		font-size: 14px;
	}
	.art-rel__corpo {
		display: flex;
		flex-direction: column;
		gap: 40px;
		padding-block: 96px var(--secao);
	}
	.art-rel__titulo {
		font-size: clamp(36px, 4vw, 56px);
		line-height: 0.95;
	}
	.art-rel__grade {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 32px;
	}
	@media (max-width: 720px) {
		.art-cab {
			padding-bottom: 32px;
			gap: 18px;
		}
		.art-cat {
			padding-top: 20px;
		}
		.art-fina {
			font-size: 18px;
		}
		.art-share .mono-caps {
			display: none;
		}
		.art-capa {
			padding-inline: 0;
		}
		.art-capa figcaption {
			padding-inline: var(--gutter);
		}
		.art-capa :global(img) {
			height: 260px;
		}
		.art-corpo {
			padding-top: 40px;
			font-size: 17px;
		}
		.art-corpo :global(h2) {
			font-size: 24px;
		}
		.art-corpo :global(blockquote) {
			font-size: 22px;
		}
		.art-bio {
			padding-bottom: 64px;
		}
		.art-rel__corpo {
			padding-block: 64px;
		}
		.art-rel__grade {
			grid-template-columns: 1fr;
		}
	}
</style>
