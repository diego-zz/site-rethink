---
/** Página de um case. */
import { decodeSlug, getEmDashEntry, getSeoMeta } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import CtaFaixa from "../../components/blocos/CtaFaixa.astro";
import Trilha from "../../components/Trilha.astro";
import {
	cachear,
	dataISO,
	getCases,
	getClientes,
	getEmpresa,
	getSolucoes,
	indice,
	nomeCliente,
	refId,
	textoPT,
	urlImagem,
	type Dados,
	type Entrada,
} from "../../lib/site";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");
const { entry, cacheHint } = await getEmDashEntry("cases", slug);
if (!entry) return Astro.rewrite("/404");
const c = entry as unknown as Entrada;
const [ca, cl, so, em] = await Promise.all([getCases(), getClientes(), getSolucoes(), getEmpresa()]);
cachear(Astro, cacheHint, ca.cacheHint, cl.cacheHint, so.cacheHint, em.cacheHint);

const d = c.data;
const origin = Astro.site?.origin ?? Astro.url.origin;
const clientes = indice(cl.todos);
const solucao = indice(so.solucoes).get(refId(d.solucao) ?? "");
const cliente = nomeCliente(c, clientes);
const seo = getSeoMeta(entry, {
	siteUrl: origin,
	path: `/cases/${c.id}`,
	defaultTitle: `Case ${cliente}${d.frase_titulo ? `: ${String(d.frase_titulo).replace(/\s+/g, " ").slice(0, 70)}` : ""}`,
	defaultDescription: d.excerpt || d.frase_titulo,
	defaultOgImage: urlImagem(d.imagem, origin),
});
const metricas: Dados[] = Array.isArray(d.metricas) ? d.metricas : [];
const entregas: Dados[] = (Array.isArray(d.entregas) ? d.entregas : []).filter((e: Dados) => e?.item);
const narrativa = [
	{ titulo: "Contexto", valor: d.contexto },
	{ titulo: "Desafio", valor: d.desafio },
	{ titulo: "O que fizemos", valor: d.o_que_fizemos, entregas: true },
	{ titulo: "Resultado", valor: d.resultado },
].filter((n) => (Array.isArray(n.valor) && n.valor.length) || (n.entregas && entregas.length));
const pos = ca.cases.findIndex((x) => x.id === c.id);
const anterior = pos > 0 ? ca.cases[pos - 1] : undefined;
const proximo = pos >= 0 && pos < ca.cases.length - 1 ? ca.cases[pos + 1] : undefined;
const empresa = em.empresa;

const artigo = {
	"@context": "https://schema.org",
	"@type": "Article",
	"@id": `${origin}/cases/${c.id}#case`,
	headline: `Case ${cliente}`,
	description: d.frase_titulo || d.excerpt,
	image: urlImagem(d.imagem, origin),
	datePublished: dataISO(d.publishedAt),
	dateModified: dataISO(d.updatedAt),
	author: { "@id": `${origin}/#organizacao` },
	publisher: { "@id": `${origin}/#organizacao` },
	about: solucao ? { "@id": `${origin}/solucoes/${solucao.id}#servico` } : undefined,
	articleBody: [d.contexto, d.desafio, d.o_que_fizemos, d.resultado].map(textoPT).filter(Boolean).join("\n\n").slice(0, 5000) || undefined,
	mainEntityOfPage: `${origin}/cases/${c.id}`,
};
---

<Base
	title={seo.title}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	content={{ collection: "cases", id: d.id, slug: c.id }}
	tipo="article"
	artigo={{ publicado: dataISO(d.publishedAt), modificado: dataISO(d.updatedAt), autor: empresa.title }}
	jsonld={[artigo]}
>
	<section>
		<div class="container case-cab">
			<Trilha itens={[{ nome: "Cases", url: "/cases" }, { nome: cliente }]} />
			<span class="rotulo case-cab__rotulo">Case{d.setor && ` · ${d.setor}`}</span>
			<h1 class="titulo-1" {...c.edit?.title}>{cliente}</h1>
			{d.frase_titulo && <p class="case-cab__frase">{d.frase_titulo}</p>}
			<dl class="case-ficha">
				<div><dt class="mono-caps">Cliente</dt><dd>{cliente}</dd></div>
				{d.setor && <div><dt class="mono-caps">Setor</dt><dd>{d.setor}</dd></div>}
				{
					solucao && (
						<div>
							<dt class="mono-caps">Solução</dt>
							<dd>
								<a href={`/solucoes/${solucao.id}`}>{solucao.data.title}</a>
							</dd>
						</div>
					)
				}
				{d.periodo && <div><dt class="mono-caps">Período</dt><dd>{d.periodo}</dd></div>}
			</dl>
		</div>
	</section>

	{
		d.imagem && (
			<div class="container">
				<Image image={d.imagem} class="case-img" priority sizes="(max-width: 1280px) 100vw, 1232px" />
			</div>
		)
	}

	{
		metricas.length > 0 && (
			<section aria-labelledby="h-num">
				<div class="container case-num">
					<h2 id="h-num" class="mono-caps case-num__titulo">Resultados</h2>
					<div class="case-num__grade">
						{metricas.map((m) => (
							<div>
								<span class="case-num__valor">{m.valor}</span>
								<span>{m.indicador}</span>
							</div>
						))}
					</div>
				</div>
			</section>
		)
	}

	{
		narrativa.length > 0 && (
			<section aria-label="História do case" class="fundo-branco">
				<div class="container secao case-hist">
					{narrativa.map((n) => (
						<div class="case-hist__item">
							<h2 class="display case-hist__titulo">{n.titulo}</h2>
							<div class="prosa case-hist__texto">
								{Array.isArray(n.valor) && n.valor.length > 0 && <PortableText value={n.valor} />}
								{n.entregas && entregas.length > 0 && (
									<ul>
										{entregas.map((e) => (
											<li>{e.item}</li>
										))}
									</ul>
								)}
								{n.entregas && d.imagem_apoio && (
									<figure class="case-apoio">
										<Image image={d.imagem_apoio} sizes="(max-width: 860px) 100vw, 720px" />
										{d.legenda_apoio && <figcaption>{d.legenda_apoio}</figcaption>}
									</figure>
								)}
							</div>
						</div>
					))}
				</div>
			</section>
		)
	}

	{
		d.depoimento && (
			<section aria-label="Depoimento do cliente">
				<figure class="container secao case-dep">
					<span class="display case-dep__aspas" aria-hidden="true">“</span>
					<blockquote>{d.depoimento}</blockquote>
					{d.depoimento_autor && <figcaption class="mono-caps">{d.depoimento_autor}</figcaption>}
				</figure>
			</section>
		)
	}

	{
		(anterior || proximo) && (
			<nav aria-label="Outros cases" class="case-nav">
				<div class="container case-nav__corpo">
					{anterior ? (
						<a href={`/cases/${anterior.id}`}>
							<span class="mono-caps">← Case anterior</span>
							<span class="display">{nomeCliente(anterior, clientes)}</span>
						</a>
					) : (
						<span />
					)}
					{proximo && (
						<a href={`/cases/${proximo.id}`} class="case-nav__prox">
							<span class="mono-caps">Próximo case →</span>
							<span class="display">{nomeCliente(proximo, clientes)}</span>
						</a>
					)}
				</div>
			</nav>
		)
	}

	<CtaFaixa
		value={{
			_key: "case-cta",
			titulo: empresa.cta_case_titulo || "Desafio parecido?",
			botao_texto: "Vamos conversar",
			botao_link: "/contato",
		}}
	/>
</Base>

<style>
	.case-cab {
		display: flex;
		flex-direction: column;
		gap: 28px;
		padding-block: 24px 64px;
	}
	.case-cab__rotulo {
		padding-top: 48px;
	}
	.case-cab__frase {
		max-width: 820px;
		font-size: 24px;
		line-height: 1.4;
		color: var(--preto);
	}
	.case-ficha {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 24px;
		padding-top: 24px;
		border-top: 1px solid var(--preto);
	}
	.case-ficha div {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.case-ficha dd {
		color: var(--preto);
	}
	:global(.case-img) {
		width: 100%;
		height: 640px;
		object-fit: cover;
	}
	.case-num {
		display: flex;
		flex-direction: column;
		gap: 32px;
		padding-block: 96px;
	}
	.case-num__titulo {
		font-weight: 500;
		font-size: 13px;
		letter-spacing: 0.12em;
		color: var(--preto);
	}
	.case-num__grade {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 32px;
		padding-top: 32px;
		border-top: 2px solid var(--preto);
	}
	.case-num__grade div {
		display: flex;
		flex-direction: column;
		gap: 8px;
		font-size: 16px;
	}
	.case-num__valor {
		font-family: var(--f-mono);
		font-weight: 500;
		font-size: clamp(48px, 6vw, 80px);
		line-height: 1;
		color: var(--azul);
	}
	.case-hist {
		display: flex;
		flex-direction: column;
		gap: 72px;
	}
	.case-hist__item {
		display: flex;
		flex-wrap: wrap;
		gap: 24px 80px;
	}
	.case-hist__item + .case-hist__item {
		padding-top: 72px;
		border-top: 1px solid var(--linha);
	}
	.case-hist__titulo {
		flex: 1 1 280px;
		font-size: 40px;
		line-height: 0.95;
	}
	.case-hist__texto {
		flex: 2 1 560px;
		max-width: 720px;
		gap: 16px;
	}
	.case-apoio {
		display: flex;
		flex-direction: column;
		gap: 8px;
		margin-top: 16px;
	}
	.case-apoio :global(img) {
		width: 100%;
		height: 380px;
		object-fit: cover;
	}
	.case-apoio figcaption {
		font-size: 13px;
		color: var(--cinza);
	}
	.case-dep {
		display: flex;
		flex-direction: column;
		gap: 28px;
	}
	.case-dep__aspas {
		font-size: 120px;
		line-height: 0.6;
	}
	.case-dep blockquote {
		max-width: 960px;
		font-size: clamp(26px, 3vw, 38px);
		line-height: 1.3;
		color: var(--preto);
	}
	.case-nav {
		border-top: 1px solid var(--preto);
	}
	.case-nav__corpo {
		display: flex;
		flex-wrap: wrap;
		gap: 24px;
		justify-content: space-between;
		padding-block: 48px var(--secao);
	}
	.case-nav a {
		display: flex;
		flex-direction: column;
		gap: 6px;
		color: var(--preto);
		text-decoration: none;
	}
	.case-nav a .display {
		font-size: 28px;
		line-height: 1;
	}
	.case-nav a:hover .display {
		color: var(--azul);
	}
	.case-nav__prox {
		text-align: right;
		margin-left: auto;
	}
	@media (max-width: 720px) {
		.case-cab {
			padding-block: 16px 40px;
			gap: 20px;
		}
		.case-cab__rotulo {
			padding-top: 24px;
		}
		.case-cab__frase {
			font-size: 19px;
		}
		.case-ficha {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 16px;
		}
		:global(.case-img) {
			height: 280px;
		}
		.case-num {
			padding-block: 56px;
		}
		.case-hist {
			gap: 48px;
		}
		.case-hist__item + .case-hist__item {
			padding-top: 48px;
		}
		.case-hist__titulo {
			font-size: 32px;
		}
		.case-apoio :global(img) {
			height: 220px;
		}
		.case-dep__aspas {
			font-size: 80px;
		}
		.case-nav a .display {
			font-size: 22px;
		}
	}
</style>
